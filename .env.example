# Default local mode supports offline development and contract checks.
HOST=127.0.0.1
PORT=8000
PRISM_LLM_MODE=local

# Submission deployment: set PRISM_LLM_MODE=gemini and supply GEMINI_API_KEY
# through the host's secret manager or process environment. Never commit a key.
# GEMINI_API_KEY=
PRISM_NORMALIZER_MODEL=gemini-3.1-flash-lite
PRISM_COMPILER_MODEL=gemini-3.8-flash

# Optional: absolute path to an already downloaded MiniLM model directory.
# PRISM_MINILM_PATH=
# PRISM_MINILM_VERSION=local-model-revision

# Optional: comma-separated allowed browser origins for a separate frontend.
# PRISM_CORS_ORIGINS=http://127.0.0.1:5173
